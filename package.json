{
  "name": "hermes-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit local para o Hermes Agent — Electron + React + Tailwind",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\" \"src/renderer/src/**/*.test.ts\" \"src/main/*.test.ts\"",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac dmg",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "smoke:win": "node scripts/smoke-electron.mjs \"release/win-unpacked/Hermes Cockpit.exe\" --out smoke-out",
    "swarm:install": "node swarm/install.mjs"
  },
  "build": {
    "appId": "com.alexandre.hermescockpit",
    "productName": "Hermes Cockpit",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Hermes Cockpit usa o microfone para ditado e transcrição local (transcriber).",
        "NSAudioCaptureUsageDescription": "Captura de áudio do sistema para transcrição local."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Hermes-Cockpit-${version}-win-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "Hermes Cockpit",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.16.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
